# ── Compiled output ──────────────────────────────────────────────
*.class
out/

# ── IntelliJ project files ───────────────────────────────────────
# .idea/workspace.xml and friends are machine-specific; the module
# file (.iml) can also be regenerated by IntelliJ on import.
.idea/
*.iml

# NOTE: libs/*.jar is intentionally NOT ignored - this project has
# no Maven/Gradle, so the sqlite-jdbc jar must stay committed for
# anyone else to be able to build/run it.

# ── Runtime-generated data ───────────────────────────────────────
# The SQLite database is created fresh on first run - don't commit
# your local order history.
*.db
*.db-journal
*.db-shm
*.db-wal

# ── OS cruft ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Logs ────────────────────────────────────────────────────────
*.log
